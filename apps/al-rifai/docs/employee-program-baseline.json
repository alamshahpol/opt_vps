    "triggers": [
      {
        "tgname": "alrifai_snapshot_immutable",
        "tgenabled": "O",
        "definition": "CREATE TRIGGER alrifai_snapshot_immutable BEFORE DELETE OR UPDATE ON public.site_source_snapshots FOR EACH ROW EXECUTE FUNCTION alrifai_reject_snapshot_change()"
      },
      {
        "tgname": "alrifai_snapshot_no_truncate",
        "tgenabled": "O",
        "definition": "CREATE TRIGGER alrifai_snapshot_no_truncate BEFORE TRUNCATE ON public.site_source_snapshots FOR EACH STATEMENT EXECUTE FUNCTION alrifai_reject_snapshot_change()"
      }
    ],
    "function": [
      {
        "definition": "CREATE OR REPLACE FUNCTION public.alrifai_reject_snapshot_change()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN RAISE EXCEPTION 'Evidence snapshots are immutable'; END;\n$function$\n"
      }
    ],
