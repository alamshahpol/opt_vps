[Unit]
Description=Al-Rifai single cached-message reconciliation producer
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/vps/apps/al-rifai/scripts/operations/reconcile-scan.py
TimeoutStartSec=1200
Nice=10
StandardOutput=null
StandardError=journal
