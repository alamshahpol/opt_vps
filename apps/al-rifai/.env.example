# Examples only. Actual configuration: /etc/vps/apps/al-rifai/app.env
PGHOST=vps-infra-postgres-1
PGSCHEMA=public
PGPASSWORD_FILE=/run/secrets/database_password
ALRIFAI_EVIDENCE_DIR=/var/lib/vps/al-rifai/evidence
ALRIFAI_VALIDATION_PASSWORD_FILE=/run/secrets/validation_password
# External integrations are hard-disabled in Phase 1.

# Named Cash workflow: keep unset until exact SQL/grants and financial checks are approved.
# ALRIFAI_CASH_POSTING_ENABLED=APPROVED_MANUAL_V1

# Unified authentication. Off by default: the deployed Basic validation guard and
# the Cash portal behave exactly as before. `shadow` proves the Cash credential on
# /login without authorising any protected route; `on` also accepts a validated
# Cash session on the workspace. Applying migration candidate 0033 and enabling
# either mode requires exact Owner approval.
# ALRIFAI_UNIFIED_AUTH_MODE=off
# ALRIFAI_UNIFIED_ORIGINS=https://alrifai.iamazim.com,https://app.al-rifai.iamazim.com
